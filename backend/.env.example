# Local development values. Railway's MySQL service automatically provides
# MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD and MYSQLDATABASE.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD
MYSQL_DATABASE=travelpay

# Optional live price providers. Keep these server-side only.
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_KEY
SERPER_API_KEY=YOUR_SERPER_KEY
